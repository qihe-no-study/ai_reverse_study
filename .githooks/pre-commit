#!/usr/bin/env node
/**
 * pre-commit 钩子：确保代码目录结构统一（以 qikan/reverse_code 为基准）
 *
 * 标准结构:
 *   <代码目录>/
 *   ├── .gitignore      (data/)
 *   ├── env/             (环境配置)
 *   ├── fetch/           (抓取入口)
 *   ├── code/            (辅助代码)
 *   ├── prompt/          (任务规格书)
 *   └── data/            (产出 — gitignore)
 *
 * 安装: git config core.hooksPath .githooks
 */

const fs = require('fs');
const path = require('path');
const { execSync } = require('child_process');

const REPO_ROOT = execSync('git rev-parse --show-toplevel', { encoding: 'utf-8' }).trim();

const STRUCTURE = ['env', 'fetch', 'code', 'prompt', 'data'];
const GITIGNORE = 'data/\n';

function isCodeDir(dir) {
  if (!fs.statSync(dir).isDirectory()) return false;
  const entries = fs.readdirSync(dir, { withFileTypes: true });
  const names = entries.map(e => e.name);

  // 已有标准结构 → 是代码目录
  if (STRUCTURE.some(d => names.includes(d))) return true;

  // 不被视为代码目录的特征（仅 .md + 子目录 → 是父级项目目录）
  const hasSubdirs = entries.some(e => e.isDirectory() && !['node_modules', '.git'].includes(e.name));
  const hasCodeFiles = entries.some(e => e.isFile() && /\.(py|js|ts)$/.test(e.name));
  const hasOnlyDocs = entries.every(e => e.isDirectory() || /\.(md|txt|html)$/.test(e.name));

  // 仅有 .md 和子目录 → 不是代码目录（如 qikan/、qq_music/）
  if (hasSubdirs && hasOnlyDocs && !hasCodeFiles) return false;

  // 有代码文件 → 是代码目录
  return hasCodeFiles;
}

function walk(dir, depth) {
  if (depth > 3) return [];
  if (!fs.existsSync(dir)) return [];
  const results = [];
  const entries = fs.readdirSync(dir, { withFileTypes: true });
  const skip = new Set(['.git', '.githooks', 'node_modules', 'understand-anything', '__pycache__', '.pnpm']);
  for (const e of entries) {
    if (!e.isDirectory() || skip.has(e.name)) continue;
    const full = path.join(dir, e.name);
    if (isCodeDir(full)) {
      results.push(full);
    } else {
      results.push(...walk(full, depth + 1));
    }
  }
  return results;
}

function classify(name) {
  const ext = path.extname(name);
  if (name === '.gitignore' || name === '.npmrc') return null;
  if (name === 'package.json' || name === 'pnpm-lock.yaml') return 'env';
  if (ext === '.py') return 'fetch';
  if (ext === '.js' || ext === '.ts' || ext === '.cjs' || ext === '.mjs') return 'code';
  if (ext === '.md') return 'prompt';
  if (ext === '.html' || ext === '.csv' || ext === '.txt') return 'data';
  if (ext === '.json') return 'env';
  return null;
}

const projects = walk(REPO_ROOT, 0);
let fixed = false;

projects.forEach(proj => {
  const rel = path.relative(REPO_ROOT, proj);

  // 确保标准子目录存在
  STRUCTURE.forEach(d => {
    const dp = path.join(proj, d);
    if (!fs.existsSync(dp)) {
      fs.mkdirSync(dp, { recursive: true });
      console.log(`[pre-commit] ✓ ${rel}/${d}/`);
      fixed = true;
    }
  });

  // 确保 .gitignore 正确
  const gi = path.join(proj, '.gitignore');
  if (!fs.existsSync(gi) || fs.readFileSync(gi, 'utf-8').trim() !== GITIGNORE.trim()) {
    fs.writeFileSync(gi, GITIGNORE);
    execSync(`git add "${path.relative(REPO_ROOT, gi).replace(/\\/g, '/')}"`);
    console.log(`[pre-commit] ✓ ${rel}/.gitignore`);
    fixed = true;
  }

  // 归位根目录散落的文件
  fs.readdirSync(proj, { withFileTypes: true })
    .filter(e => e.isFile())
    .forEach(f => {
      const destDir = classify(f.name);
      if (!destDir) return;
      const src = path.join(proj, f.name);
      const dest = path.join(proj, destDir, f.name);
      if (fs.existsSync(dest)) return;

      fs.renameSync(src, dest);
      try { execSync(`git rm --cached "${path.relative(REPO_ROOT, src).replace(/\\/g, '/')}" 2>/dev/null`); } catch (_) {}
      execSync(`git add "${path.relative(REPO_ROOT, dest).replace(/\\/g, '/')}"`);
      console.log(`[pre-commit] → ${rel}/${f.name} → ${destDir}/`);
      fixed = true;
    });
});

if (fixed) console.log('[pre-commit] ✅ 目录结构已自动调整');
