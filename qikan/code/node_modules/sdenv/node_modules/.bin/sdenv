#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/proc/cygdrive/d/ai/ai_reverser/qikan/code/node_modules/.pnpm/sdenv@1.1.3_@types+node@25.7.0/node_modules/sdenv/node_modules:/proc/cygdrive/d/ai/ai_reverser/qikan/code/node_modules/.pnpm/sdenv@1.1.3_@types+node@25.7.0/node_modules:/proc/cygdrive/d/ai/ai_reverser/qikan/code/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/proc/cygdrive/d/ai/ai_reverser/qikan/code/node_modules/.pnpm/sdenv@1.1.3_@types+node@25.7.0/node_modules/sdenv/node_modules:/proc/cygdrive/d/ai/ai_reverser/qikan/code/node_modules/.pnpm/sdenv@1.1.3_@types+node@25.7.0/node_modules:/proc/cygdrive/d/ai/ai_reverser/qikan/code/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../example/use-check/index.js" "$@"
else
  exec node  "$basedir/../../example/use-check/index.js" "$@"
fi
